+// ============================================================
+// BlockHeaders
+// ============================================================
+
+/// The one way this module reads block headers. It hides whether a header
+/// came from the cache or the provider.
+#[derive(Clone)]
+struct BlockHeaders<P> {
+    provider: P,
+    store: Arc<LogCache>,
+}
+
+impl<P: Provider<Ethereum>> BlockHeaders<P> {
+    /// Returns the header of the given block from the cache. On a cache miss,
+    /// it fetches the header from the provider and caches it. Errors when the
+    /// provider has no such block.
+    async fn header(&self, block_number: u64) -> Result<BlockHeader, HistoryError> {
+        if let Some(header) = self
+            .store
+            .get_block_header(block_number)
+            .map_err(|e| HistoryError::internal(e.to_string()))?
+        {
+            cache_event(CacheLayer::BlockHeader, CacheOutcome::Hit);
+            return Ok(header);
+        }
+        cache_event(CacheLayer::BlockHeader, CacheOutcome::Miss);
+
+        let block = self
+            .provider
+            .get_block_by_number(BlockNumberOrTag::Number(block_number))
+            .into_future()
+            .instrument(rpc_span(RpcMethod::GetBlockByNumber))
+            .await
+            .map_err(|e| HistoryError::internal(format!("get_block failed: {e}")))?
+            .ok_or_else(|| HistoryError::internal(format!("block {block_number} not found")))?;
+
+        let hash: [u8; 32] = block.header.hash.0;
+        let parent_hash: [u8; 32] = block.header.parent_hash.0;
+        let timestamp = block.header.timestamp;
+
+        self.store
+            .insert_block_header(block_number, &hash, &parent_hash, timestamp)
+            .map_err(|e| HistoryError::internal(e.to_string()))?;
+
+        Ok(BlockHeader {
+            height: block_number,
+            hash,
+            parent_hash,
+            timestamp,
+        })
+    }
+
+    /// Returns the timestamp of the given log's block. Uses the timestamp the
+    /// log carries when the provider sent one, and otherwise the block's header
+    /// from [`header`](Self::header). Errors as that method does.
+    async fn log_timestamp(&self, log: &Log) -> Result<Timestamp, HistoryError> {
+        if let Some(timestamp) = log.block_timestamp {
+            return Ok(timestamp);
+        }
+        let block_number = log.block_number.unwrap_or(0);
+        Ok(self.header(block_number).await?.timestamp)
+    }
+}
