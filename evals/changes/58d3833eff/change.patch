+@dataclass
+class Reply:
+    """The answer of one headless claude call."""
+
+    result: str
+    structured: dict | None  # the answer to --json-schema, when the call passed one
+    cost_usd: float
+
+
+def claude(*args, stdin="", cwd=None, log=None):
+    """Runs `claude -p` with args under the eval config and returns its reply.
+
+    args are the prompt, if any, and flags. stdin is piped in, as the prompt or
+    beside it. log, when given, receives claude's stdout and stderr.
+    Errors when claude exits non-zero, prints no JSON, or reports an error.
+    """
+    cmd = ["claude", "-p", "--output-format", "json", "--no-session-persistence", *args]
+    out = subprocess.run(cmd, input=stdin, cwd=cwd, text=True, capture_output=True,
+                         env=os.environ | {"CLAUDE_CONFIG_DIR": str(CONFIG)})
+    if log:
+        log.write_text(out.stdout + out.stderr)
+    failure = RuntimeError(out.stderr.strip()[:200] or out.stdout[:200])
+    if out.returncode:
+        raise failure
     try:
-        return json.loads(out.stdout).get("total_cost_usd", 0.0)
+        reply = json.loads(out.stdout)
     except json.JSONDecodeError:
-        return 0.0
+        raise failure from None
+    if reply.get("is_error"):
+        raise failure
+    return Reply(reply.get("result", ""), reply.get("structured_output"), reply.get("total_cost_usd", 0.0))
+
+
+def run_skill(repo, log, args):
+    """Runs one round of the skill in repo and returns its cost in USD.
+
+    Errors when the claude call fails. The log and the skill's record are kept either way.
+    """
+    try:
+        return claude(f"/unsmell:unsmell {args}".strip(), "--plugin-dir", str(SKILL_REPO),
+                      "--permission-mode", "auto", "--permission-prompts", "none",
+                      # No --max-budget-usd: the agent sees the cap and skips the survey agents to stay under it.
+                      "--allowedTools", *ALLOWED, cwd=repo, log=log).cost_usd
+    finally:
+        # The skill's own record of the round (§3.0 of SKILL.md): batches, findings, decisions.
+        record = repo / ".git" / "unsmell"
+        if record.exists():
+            shutil.move(record, log.with_suffix(""))
+            git(repo, "worktree", "prune")  # editors' worktrees the skill left behind
 
 
