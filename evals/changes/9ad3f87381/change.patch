 }
 
+/// `Topic` persists as its 32 raw bytes in a `BLOB` column. Like
+/// [`FilterHash`]'s, this `ToSql` lives in the persistence layer so the domain
+/// type stays `SQLite`-free.
+impl ToSql for Topic {
+    fn to_sql(&self) -> rusqlite::Result<ToSqlOutput<'_>> {
+        Ok(ToSqlOutput::from(self.as_slice()))
+    }
+}
+
+/// Reads a `Topic` back from its 32-byte `BLOB`, as the event-signature cache
+/// does for `topic0`.
+///
+/// Errors when the value is not a `BLOB`, or is a `BLOB` of any length other
+/// than 32 (`FromSqlError::InvalidBlobSize`).
+impl FromSql for Topic {
+    fn column_result(value: ValueRef<'_>) -> FromSqlResult<Self> {
+        let blob = value.as_blob()?;
+        B256::try_from(blob)
+            .map(Topic::new)
+            .map_err(|_| FromSqlError::InvalidBlobSize {
+                expected_size: 32,
+                blob_size: blob.len(),
+            })
+    }
+}
+
