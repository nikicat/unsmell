 func (b *prompterBridge) BeginPrompting(msg dbus.Message, callback dbus.ObjectPath) *dbus.Error {
 	if err := b.exportCallback(callback, senderOf(msg)); err != nil {
 		return dbustypes.ErrFailed(err)
 	}
