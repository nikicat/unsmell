+def link_stacked(tasks, changes):
+    """Stacks each task's change on the changes of the tasks it starts from (SKILL.md §3.0, step 4).
+
+    changes maps a task's name to the id of its change. A stacked change is reviewed on top of its parents.
+    """
+    for task in tasks:
+        parents = [changes[t] for t in task.after if t in changes]
+        if parents:
+            path = CHANGES / changes[task.name] / "change.yaml"
+            meta = load(path)
+            meta["after"] = parents
+            dump(path, meta)
+
+
+def extract(path):
+    """Adds the changes of one run to the dataset and stores its rounds. Returns the ids of the changes it saw."""
+    run = RunDir(path.resolve())
+    report = Report.load(run.report)
+    store_rounds(run, report)
+    ids = set()
+    for n in (r.round for r in report.rounds):
+        for record in skill_runs(run, n):
+            found = tasks(record)
+            changes = {t.name: record_change(record, t, report.fixture,
+                                             {"run": run.name, "round": n, "task": t.name}) for t in found}
+            link_stacked(found, changes)
+            ids |= set(changes.values())
     return ids
 
 
