+def redirect_code(url: str, state: str) -> str:
+    """Returns the authorization code from the URL that the bank redirected to.
+
+    Exits when the URL has no code or carries a state other than the given one.
+    The exit message is the bank's error when the URL has one.
+    """
+    query = {key: values[0] for key, values in parse_qs(urlparse(url.strip()).query).items()}
+    if "code" not in query or query.get("state") != state:
+        error = ": ".join(query[key] for key in ("error", "error_description") if key in query)
+        sys.exit(f"bad redirect: {error or 'no code, or the state does not match'}")
+    return query["code"]
+
+
+def still_valid(session: dict) -> bool:
+    """Checks whether the given session still grants access."""
+    return datetime.fromisoformat(session["access"]["valid_until"]) > datetime.now(timezone.utc)
+
+
+@dataclass(frozen=True)
+class EnableBanking:
+    """A client of the Enable Banking API that signs each request as the given application."""
+
+    app_id: str
+    key: bytes
+    psu: dict[str, str]
+
+    def call(self, method, path, **kw):
+        now = int(datetime.now(timezone.utc).timestamp())
+        token = jwt.encode(
+            {"iss": "enablebanking.com", "aud": "api.enablebanking.com", "iat": now, "exp": now + 3600},
+            self.key, algorithm="RS256", headers={"kid": self.app_id},
+        )
+        headers = {"Authorization": f"Bearer {token}"} | self.psu
+        r = requests.request(method, API + path, headers=headers, timeout=60, **kw)
+        if not r.ok:
+            sys.exit(f"{method} {path}: {r.status_code} {r.text}")
+        return r.json()
+
+    def session(self) -> dict:
+        """Returns a session that is valid now, either the saved one or a new one from authorize()."""
+        if SESSION.exists():
+            saved = json.loads(SESSION.read_text())
+            if still_valid(saved):
+                return saved
+        session = self.authorize()
+        SESSION.write_text(json.dumps(session, indent=2))
+        return session
+
+    def authorize(self) -> dict:
+        """Returns a new session after the user logs in with Smart-ID."""
+        state = str(uuid.uuid4())
+        url = self.start_auth(state)
+        print(f"Open, log in with Smart-ID, then paste the URL you land on:\n{url}")
+        code = redirect_code(input("> "), state)
+        return self.call("POST", "/sessions", json={"code": code})
+
+    def start_auth(self, state: str) -> str:
+        """Returns the bank's login URL for a new authorization with the given state."""
+        valid_until = datetime.now(timezone.utc) + timedelta(days=180)  # PSD2 max; bank may cap lower
+        return self.call("POST", "/auth", json={
+            "access": {"valid_until": valid_until.isoformat()},
+            "aspsp": {"name": os.environ.get("EB_ASPSP", "SEB"), "country": "LT"},
+            "state": state,
+            "redirect_url": REDIRECT,
+            "psu_type": "personal",
+        })["url"]
+
+    def transactions(self, uid: str, date_from: date | None) -> Iterator[dict]:
+        params = {"date_from": date_from.isoformat()} if date_from else {}
+        while True:
+            page = self.call("GET", f"/accounts/{uid}/transactions", params=params)
+            yield from page["transactions"]
+            if not page.get("continuation_key"):
+                return
+            params["continuation_key"] = page["continuation_key"]
+
+
+@dataclass(frozen=True)
+class Ledger:
+    """The stored transactions of each account, keyed by IBAN and entry reference."""
+
+    db: sqlite3.Connection
+
+    @classmethod
+    def open(cls, path: Path) -> Ledger:
+        """Opens the ledger at the given path and creates its tables when they are missing."""
+        db = sqlite3.connect(path)
+        db.executescript(Path(__file__).with_name("schema.sql").read_text())
+        return cls(db)
+
+    def last_booking_date(self, iban: str) -> date | None:
+        (day,) = self.db.execute("SELECT max(booking_date) FROM txn WHERE iban = ?", (iban,)).fetchone()
+        return date.fromisoformat(day) if day else None
+
+    def count(self, iban: str) -> int:
+        (count,) = self.db.execute("SELECT count(*) FROM txn WHERE iban = ?", (iban,)).fetchone()
+        return count
+
+    def upsert(self, iban: str, txs: Iterable[dict]) -> None:
+        """Stores the given transactions of the account.
+
+        A transaction that is already stored under its entry reference is updated, not added again.
+        """
+        with self.db:
+            self.db.executemany(
+                "INSERT INTO txn (iban, entry_reference, raw) VALUES (?, ?, ?)"
+                " ON CONFLICT DO UPDATE SET raw = excluded.raw WHERE raw IS NOT excluded.raw",
+                [(iban, t["entry_reference"], json.dumps(t, ensure_ascii=False)) for t in txs])
+
+
+def progress(txs: Iterable[dict], label: str) -> Iterator[dict]:
+    """Yields the given transactions and shows on stderr how many have passed."""
+    for count, tx in enumerate(txs, 1):
+        print(f"\r{label}: {count} transactions", end="", file=sys.stderr, flush=True)
+        yield tx
+    print(file=sys.stderr)
+
+
