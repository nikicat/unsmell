+/// Decodes a `U256` stored as its 32 big-endian bytes in a `BLOB` column, the
+/// encoding [`Erc20Cache`] writes balances with.
+///
+/// Args:
+///     bytes: The raw column value.
+///
+/// Returns:
+///     The decoded value, or `None` when the blob is not exactly 32 bytes long.
+fn u256_from_blob(bytes: &[u8]) -> Option<U256> {
+    <[u8; 32]>::try_from(bytes).ok().map(U256::from_be_bytes)
+}
