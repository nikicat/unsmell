+def user_version(db: sqlite3.Connection) -> int:
+    return db.execute("PRAGMA user_version").fetchone()[0]
+
+
+def rebuild(schema: str) -> str:
+    """Returns a script that recreates txn from schema and keeps its stored columns.
+    The other columns are generated from raw, so the copy loses nothing."""
+    return (
+        "BEGIN;"
+        " CREATE TEMP TABLE txn_old AS SELECT iban, entry_reference, raw FROM txn;"
+        " DROP TABLE txn;\n"
+        f"{schema}\n"
+        "INSERT INTO txn (iban, entry_reference, raw) SELECT * FROM txn_old;"
+        " DROP TABLE txn_old;"
+        " COMMIT;"
+    )
+
