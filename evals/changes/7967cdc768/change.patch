+/// `Topic` persists as its 32 raw bytes in a `BLOB` column. Like the impls
+/// above, this one lives in the persistence layer so the domain type stays
+/// `SQLite`-free.
+impl ToSql for Topic {
+    fn to_sql(&self) -> rusqlite::Result<ToSqlOutput<'_>> {
+        Ok(ToSqlOutput::from(self.as_slice()))
+    }
+}
+
+/// Reads a `Topic` back from its 32-byte `BLOB`.
+///
+/// Errors when the value is not a `BLOB`, or with
+/// [`FromSqlError::InvalidBlobSize`](rusqlite::types::FromSqlError::InvalidBlobSize)
+/// when the blob is not 32 bytes long.
+impl FromSql for Topic {
+    fn column_result(value: ValueRef<'_>) -> FromSqlResult<Self> {
+        <[u8; 32]>::column_result(value).map(|bytes| Self::new(B256::from(bytes)))
+    }
+}
