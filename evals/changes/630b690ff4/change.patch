+@dataclass(frozen=True)
+class LabelEntry:
+    """A label that a person or a tool gave a change, about one of its findings or the whole change."""
+
+    label: Label
+    by: str  # USER, or a name starting with it, when a person gave the label
+    date: str  # in ISO format
+    finding: str | None = None  # the id of the finding, or None for the whole change
+    note: str = ""
+
+    @classmethod
+    def parse(cls, entry):
+        return cls(Label(entry["label"]), entry["by"], entry["date"], entry.get("finding"), entry.get("note", ""))
+
+    def dump(self):
+        """Returns the entry as change.yaml stores it, without the fields that are empty."""
+        entry = {"label": self.label.value, "finding": self.finding, "note": self.note, "by": self.by,
+                 "date": self.date}
+        return {k: v for k, v in entry.items() if v}
+
+    @property
+    def by_user(self):
+        """Whether a person gave the label."""
+        return self.by.startswith(USER)
+
