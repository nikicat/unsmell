+
+    @classmethod
+    def parse(cls, entry):
+        return cls(Label(entry["label"]), entry["confidence"], entry["reason"], entry["model"])
+
+    def dump(self):
+        """Returns the proposal as change.yaml stores it."""
+        return {"label": self.label.value, "confidence": self.confidence, "reason": self.reason,
+                "model": self.model}
+
+
+@dataclass
+class Change:
+    """A patch that one task of an eval run made, with the runs that made it and the labels it was given.
+
+    The dataset stores it in evals/changes/<id>/ as change.patch and change.yaml.
+    """
+
+    id: str
+    fixture: str
+    seen: list[Sighting]  # the first is the one the patch was made in
+    judge: Proposal | None = None
+    labels: list[LabelEntry] = field(default_factory=list)  # oldest first
+    findings: list[dict] = field(default_factory=list)  # each with its entry of decisions.yaml under "triage"
+    after: list[str] = field(default_factory=list)  # the ids of the changes this one is stacked on
+    check: CheckStatus | None = None  # None until the fixture's check has run on it
+
+    @staticmethod
+    def _yaml_file(cid):
+        return CHANGES / cid / "change.yaml"
+
+    @classmethod
+    def named(cls, cid):
+        """Reads the change cid from the dataset.
+
+        Errors with FileNotFoundError when the dataset has no change cid.
+        """
+        meta = load(cls._yaml_file(cid))
+        return cls(meta["id"], meta["fixture"], [Sighting(**s) for s in meta["seen"]],
+                   Proposal.parse(meta["judge"]) if meta["judge"] else None,
+                   [LabelEntry.parse(l) for l in meta["labels"]], meta.get("findings", []), meta.get("after", []),
+                   CheckStatus(meta["check"]) if "check" in meta else None)
+
+    def save(self):
+        """Writes change.yaml. It leaves out after and check while they are unset."""
+        meta = {"id": self.id, "fixture": self.fixture, "seen": [s._asdict() for s in self.seen],
+                "judge": self.judge and self.judge.dump(), "labels": [l.dump() for l in self.labels],
+                "findings": self.findings}
+        if self.after:
+            meta["after"] = self.after
+        if self.check:
+            meta["check"] = self.check.value
+        self.dir.mkdir(parents=True, exist_ok=True)
+        dump(self.yaml_file, meta)
+
+    @property
+    def yaml_file(self):
+        return self._yaml_file(self.id)
+
+    @property
+    def dir(self):
+        return self.yaml_file.parent
+
+    @property
+    def patch_file(self):
+        return self.dir / "change.patch"
+
+    @property
+    def log_file(self):
+        """The path of the output of a check that failed or did not apply."""
+        return self.dir / "check.log"
+
+    @property
+    def patch(self):
+        return self.patch_file.read_text()
+
+    @property
+    def has_patch(self):
+        """Whether the change's editor made a patch."""
+        return bool(self.patch.strip())
+
+    @property
+    def first(self):
+        """The sighting the patch was made in."""
+        return self.seen[0]
+
+    @property
+    def runs(self):
+        """The names of the runs that made the change."""
+        return {s.run for s in self.seen}
+
+    @property
+    def newest_label(self):
+        """The newest label entry, or None when the change has none."""
+        return self.labels[-1] if self.labels else None
+
+    @property
+    def user_labels(self):
+        """The label entries that a person gave, oldest first."""
+        return [l for l in self.labels if l.by_user]
+
+    @property
+    def newest_user_label(self):
+        """The newest label entry that a person gave, or None when no person labelled the change."""
+        return self.user_labels[-1] if self.user_labels else None
+
+    @property
+    def score_label(self):
+        """What score counts the change as: its newest label, else the judge's as judge:LABEL, else unlabelled."""
+        if self.newest_label:
+            return self.newest_label.label.value
+        return f"judge:{self.judge.label}" if self.judge else "unlabelled"
+
+    @property
+    def decisions(self):
+        """The decisions of the change's findings, sorted and joined by /."""
+        return "/".join(sorted({f["triage"]["decision"] for f in self.findings}))
+
+    @property
+    def summary(self):
+        """The decisions and the start of the first finding's claim, on one line."""
+        return f"{self.decisions}: {self.findings[0].get('claim', '')[:100]}"
+
+    @cached_property
+    def tokens(self):
+        """The words of the changed lines and of the findings' claims, for comparing changes."""
+        text = " ".join([*(c.line.text for c in changed_lines(self.patch)),
+                         *(f.get("claim", "") for f in self.findings)])
+        return frozenset(re.findall(r"\w+", text))
+
+    @property
+    def ancestors(self):
+        """The changes this one is stacked on, directly or not, each before its dependents."""
+        found = {}
+        for parent in map(Change.named, self.after):
+            found |= {c.id: c for c in [*parent.ancestors, parent]}
+        return list(found.values())
+
+    def from_other_runs(self, other):
+        """Tells whether other is a different change that none of this change's runs made."""
+        return other.id != self.id and not self.runs & other.runs
+
