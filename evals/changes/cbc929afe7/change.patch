--- a/internal/notification/slow_upstream_test.go
+++ b/internal/notification/slow_upstream_test.go
@@ -276,3 +276,31 @@ func TestSlowUpstreamNotifier_ProcessChainOnly(t *testing.T) {
 		t.Errorf("unexpected body: %q", mock.notified[0].body)
 	}
 }
+
+func TestSlowUpstreamNotifier_EscapesInjectedMarkup(t *testing.T) {
+	mock := &mockNotifier{}
+	n := newSlowUpstreamNotifier(mock)
+
+	ctx := proxy.UpstreamCallContext{
+		Items: []approval.ItemInfo{
+			{Label: `<a href="x">pay</a> & co`},
+			{Path: "/org/<b>evil</b>"},
+		},
+		SenderInfo: approval.SenderInfo{
+			ProcessChain: []approval.ProcessInfo{
+				{Name: "<i>git</i>", PID: 1234},
+				{Name: "zsh", PID: 1000},
+			},
+		},
+	}
+	dismiss := n.NotifySlowUpstream(ctx)
+	defer dismiss()
+
+	mock.mu.Lock()
+	defer mock.mu.Unlock()
+	expected := "&lt;a href=&#34;x&#34;&gt;pay&lt;/a&gt; &amp; co, /org/&lt;b&gt;evil&lt;/b&gt; (2 items)\n" +
+		"&lt;i&gt;git&lt;/i&gt; \u2190 zsh"
+	if mock.notified[0].body != expected {
+		t.Errorf("unexpected body:\ngot:  %q\nwant: %q", mock.notified[0].body, expected)
+	}
+}
