+def parse_redirect(url: str, state: str) -> str:
+    """Returns the authorization code from the URL that the bank redirected to.
+    Exits when the URL does not belong to the login with this state.
+    Exits with the bank's error and error_description when the URL has no code."""
+    q = parse_qs(urlparse(url).query)
+    if q.get("state") != [state]:
+        sys.exit(f"bad redirect: {q}")
+    if code := q.get("code"):
+        return code[0]
+    reason = q.get("error", ["no code"]) + q.get("error_description", [])
+    sys.exit(f"login failed: {': '.join(reason)}")
+
