+class Sign(StrEnum):
+    """The mark that a unified diff puts before a changed line."""
+
+    ADDED = "+"
+    REMOVED = "-"
+
+    @property
+    def header(self):
+        """The start of the header line that names the file on this side."""
+        return self * 3 + " "
+
+    @property
+    def prefix(self):
+        """The prefix that git diff puts before the path on this side."""
+        return "b/" if self is Sign.ADDED else "a/"
+
+
+class Line(NamedTuple):
+    """One line of a file and the path of that file."""
+
+    path: str
+    text: str
+
+    @property
+    def significant(self):
+        """Whether the line carries a change of its own.
+
+        A line of three characters or fewer, such as a brace, `end` or a blank line,
+        is set by the lines around it. Counting it would make unrelated changes look alike.
+        """
+        return len(self.text.strip()) > 3
+
+
+class ChangedLine(NamedTuple):
+    """One line that a diff adds or removes. A removed line has the old path, an added line the new one."""
+
+    sign: Sign
+    line: Line
+
+
+@dataclass
+class FileDiff:
+    """The part of a unified diff that changes one file."""
+
+    headers: list[str] = field(default_factory=list)
+    """The `---` and `+++` lines as written."""
+    changes: list[ChangedLine] = field(default_factory=list)
+    paths: dict[Sign, str] = field(default_factory=dict)
+    """The path on each side, without git's prefix. A side that is /dev/null has none."""
+
+    def read_header(self, line):
+        """Takes the path from a `---` or `+++` line."""
+        self.headers.append(line)
+        sign = Sign(line[0])
+        path = line.removeprefix(sign.header).removesuffix("\t")
+        if path != "/dev/null":
+            self.paths[sign] = path.removeprefix(sign.prefix)
+
+
+def parse_diff(diff):
+    """Splits a unified diff into the parts that change one file each.
+
+    A part's header runs from its `diff --git` line to its first `@@` line. Lines
+    before the first `diff --git` form a part of their own.
+    """
+    parts, in_header = [], True
+    for line in diff.splitlines():
+        if line.startswith("diff --git ") or not parts:
+            parts.append(FileDiff())
+            in_header = True
+        part = parts[-1]
+        if line.startswith("@@"):
+            in_header = False
+        elif in_header:
+            if line.startswith(tuple(sign.header for sign in Sign)):
+                part.read_header(line)
+        elif line[:1] in Sign:
+            sign = Sign(line[0])
+            part.changes.append(ChangedLine(sign, Line(part.paths[sign], line[1:])))
+    return parts
+
+
+def changed_lines(diff):
+    """Yields every line that a unified diff adds or removes, in the diff's order."""
+    for part in parse_diff(diff):
+        yield from part.changes
+
