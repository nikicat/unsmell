+@dataclass(frozen=True)
+class Repo:
+    """A git repo that a run changes round by round."""
+
+    path: Path
+
+    def git(self, *args, env=None):
+        return git(self.path, *args, env=env)
+
+    def snapshot(self):
+        """Returns the git tree of the working directory, leaving the index and HEAD alone."""
+        env = os.environ | {"GIT_INDEX_FILE": str(self.path / ".git" / "eval-index")}
+        self.git("add", "-A", env=env)
+        return self.git("write-tree", env=env).strip()
+
+    def diff(self, old, new):
+        """Returns the lines that tree new adds and removes against tree old."""
+        return Delta.parse(self.git("diff", "-U0", old, new))
+
+    def clear(self):
+        """Deletes the working tree, keeping .git."""
+        for item in self.path.iterdir():
+            if item.name != ".git":
+                shutil.rmtree(item) if item.is_dir() else item.unlink()
 
 
