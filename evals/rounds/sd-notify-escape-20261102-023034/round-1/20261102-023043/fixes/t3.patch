+// Pins the whole body for each request kind, including the edge cases of each.
+func TestHandler_FormatBody_Exact(t *testing.T) {
+	chain := []approval.ProcessInfo{{Name: "bash", PID: 100}, {Name: "git", PID: 200}}
+
+	tests := []struct {
+		name     string
+		showPIDs bool
+		req      *approval.Request
+		want     string
+	}{
+		{
+			name:     "gpg with chain and pids",
+			showPIDs: true,
+			req: &approval.Request{
+				Type:        approval.RequestTypeGPGSign,
+				GPGSignInfo: &approval.GPGSignInfo{RepoName: "repo", CommitMsg: "subj\nbody"},
+				SenderInfo:  approval.SenderInfo{ProcessChain: chain},
+			},
+			want: "<b>repo</b>: <i>subj</i>\nbash[100] ← git[200]",
+		},
+		{
+			name: "gpg without info",
+			req: &approval.Request{
+				Type:       approval.RequestTypeGPGSign,
+				SenderInfo: approval.SenderInfo{ProcessChain: chain},
+			},
+			want: "",
+		},
+		{
+			name: "ssh with destination",
+			req: &approval.Request{
+				Type:       approval.RequestTypeSSHSign,
+				Items:      []approval.ItemInfo{{Label: "key", Attributes: map[string]string{"destination": "host"}}},
+				SenderInfo: approval.SenderInfo{ProcessChain: chain},
+			},
+			want: "<b>key</b> → host\nbash ← git",
+		},
+		{
+			name: "ssh with empty destination",
+			req: &approval.Request{
+				Type:  approval.RequestTypeSSHSign,
+				Items: []approval.ItemInfo{{Label: "key", Attributes: map[string]string{"destination": ""}}},
+			},
+			want: "<b>key</b>",
+		},
+		{
+			name: "ssh without items",
+			req: &approval.Request{
+				Type:       approval.RequestTypeSSHSign,
+				SenderInfo: approval.SenderInfo{ProcessChain: chain},
+			},
+			want: "\nbash ← git",
+		},
+		{
+			name: "items with chain",
+			req: &approval.Request{
+				Type:       approval.RequestTypeGetSecret,
+				Items:      []approval.ItemInfo{{Label: "a"}, {Label: "b"}},
+				SenderInfo: approval.SenderInfo{ProcessChain: chain},
+			},
+			want: "<b>2 items</b>\nbash ← git",
+		},
+		{
+			name: "search all with chain",
+			req: &approval.Request{
+				Type:       approval.RequestTypeSearch,
+				SenderInfo: approval.SenderInfo{ProcessChain: chain},
+			},
+			want: "<b>all</b>\nbash ← git",
+		},
+		{
+			name: "unlock with chain",
+			req: &approval.Request{
+				Type:       approval.RequestTypeUnlock,
+				SenderInfo: approval.SenderInfo{ProcessChain: chain},
+			},
+			want: "\nbash ← git",
+		},
+		{
+			name: "legacy invoker",
+			req: &approval.Request{
+				Type:       approval.RequestTypeGetSecret,
+				Client:     "c",
+				Items:      []approval.ItemInfo{{Label: "l"}},
+				SenderInfo: approval.SenderInfo{InvokerName: "svc", PID: 42},
+			},
+			want: "<b>svc</b>@c[42]: <i>l</i>",
+		},
+		{
+			name: "legacy pid only",
+			req: &approval.Request{
+				Type:       approval.RequestTypeSearch,
+				Client:     "c",
+				SenderInfo: approval.SenderInfo{PID: 42},
+			},
+			want: "<b>c</b>[42]: <i>all</i>",
+		},
+		{
+			name: "legacy unlock bare client",
+			req: &approval.Request{
+				Type:   approval.RequestTypeUnlock,
+				Client: "c",
+			},
+			want: "<b>c</b>: ",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h := NewHandler(&mockNotifier{}, &mockApprover{}, "http://127.0.0.1:8484", tc.showPIDs, 2*time.Minute, 0)
+			assert.Equal(t, tc.want, h.formatBody(tc.req))
+		})
+	}
+}
