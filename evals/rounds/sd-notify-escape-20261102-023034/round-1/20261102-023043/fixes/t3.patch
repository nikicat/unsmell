+// Writes the repo name, the commit subject and the process chain. Writes
+// nothing when req has no signing info.
+func (h *Handler) gpgBody(b *bodyMarkup, req *approval.Request) {
+	info := req.GPGSignInfo
+	if info == nil {
+		return
+	}
+	b.bold(info.RepoName)
+	b.text(": ")
+	b.italic(commitSubject(info.CommitMsg))
+	b.processChain(req.SenderInfo.ProcessChain, h.showPIDs)
+}
+
+// Writes the key label, the destination when there is one, and the process
+// chain.
+func (h *Handler) sshBody(b *bodyMarkup, req *approval.Request) {
+	if len(req.Items) > 0 {
+		b.bold(req.Items[0].Label)
+		if dest := req.Items[0].Attributes["destination"]; dest != "" {
+			b.text(" → " + dest)
 		}
 	}
+	b.processChain(req.SenderInfo.ProcessChain, h.showPIDs)
+}
 
-	return b.String()
+// Writes the request subject, then the process chain from parent to child.
+func (h *Handler) itemsBody(b *bodyMarkup, req *approval.Request) {
+	if subject, ok := requestSubject(req); ok {
+		b.bold(subject)
+	}
+	b.processChain(req.SenderInfo.ProcessChain, h.showPIDs)
+}
+
+// Writes the sender and the request subject for a request without a process
+// chain, such as one from a remote client.
+func legacyBody(b *bodyMarkup, req *approval.Request) {
+	switch {
+	case req.SenderInfo.InvokerName != "":
+		b.bold(req.SenderInfo.InvokerName)
+		b.text(fmt.Sprintf("@%s[%d]: ", req.Client, req.SenderInfo.PID))
+	case req.SenderInfo.PID != 0:
+		b.bold(req.Client)
+		b.text(fmt.Sprintf("[%d]: ", req.SenderInfo.PID))
+	default:
+		b.bold(req.Client)
+		b.text(": ")
+	}
+	if subject, ok := requestSubject(req); ok {
+		b.italic(subject)
+	}
 }
 
