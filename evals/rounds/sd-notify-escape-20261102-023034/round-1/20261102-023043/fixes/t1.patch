+// Returns the plain text that names what req asks for. For a get, delete or
+// write request it is the item label, or "N items" unless there is exactly one
+// item. For a search it is the attributes as "k=v, k=v", or "all" when there
+// are none. Reports false for every other request type.
+func requestSubject(req *approval.Request) (string, bool) {
+	switch req.Type {
+	case approval.RequestTypeGetSecret, approval.RequestTypeDelete, approval.RequestTypeWrite:
+		if len(req.Items) == 1 {
+			return req.Items[0].Label, true
+		}
+		return fmt.Sprintf("%d items", len(req.Items)), true
+	case approval.RequestTypeSearch:
+		if len(req.SearchAttributes) == 0 {
+			return "all", true
+		}
+		attrs := make([]string, 0, len(req.SearchAttributes))
+		for k, v := range req.SearchAttributes {
+			attrs = append(attrs, k+"="+v)
+		}
+		return strings.Join(attrs, ", "), true
+	}
+	return "", false
+}
