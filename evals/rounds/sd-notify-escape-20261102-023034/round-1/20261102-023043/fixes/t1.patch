diff --git a/internal/notification/markup.go b/internal/notification/markup.go
new file mode 100644
index 0000000..489ee70
--- /dev/null
+++ b/internal/notification/markup.go
@@ -0,0 +1,56 @@
+package notification
+
+import (
+	"fmt"
+	"html"
+	"strings"
+
+	"github.com/nikicat/secrets-dispatcher/internal/approval"
+)
+
+// The one way formatters write a notification body. Its methods escape every
+// string they are given, so client text cannot add markup to the approve/deny
+// prompt.
+type bodyMarkup struct {
+	b strings.Builder
+}
+
+// Appends s as plain text.
+func (m *bodyMarkup) text(s string) {
+	m.b.WriteString(html.EscapeString(s))
+}
+
+// Appends s in bold.
+func (m *bodyMarkup) bold(s string) {
+	m.b.WriteString("<b>")
+	m.text(s)
+	m.b.WriteString("</b>")
+}
+
+// Appends s in italics.
+func (m *bodyMarkup) italic(s string) {
+	m.b.WriteString("<i>")
+	m.text(s)
+	m.b.WriteString("</i>")
+}
+
+// Appends the process names on a new line, joined by arrows. When showPIDs
+// is set, each name is followed by its PID in brackets.
+func (m *bodyMarkup) processChain(chain []approval.ProcessInfo, showPIDs bool) {
+	for i, p := range chain {
+		if i == 0 {
+			m.text("\n")
+		} else {
+			m.text(" ← ")
+		}
+		m.text(p.Name)
+		if showPIDs {
+			m.text(fmt.Sprintf("[%d]", p.PID))
+		}
+	}
+}
+
+// Returns the body written so far.
+func (m *bodyMarkup) String() string {
+	return m.b.String()
+}
