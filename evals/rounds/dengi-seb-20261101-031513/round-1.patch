+def counted[T](items: Iterable[T], label: str) -> Iterator[T]:
+    """Yields items unchanged and shows on stderr how many have passed."""
+    n = 0
+    for n, item in enumerate(items, 1):
+        print(f"\r{label}: {n}", end="", file=sys.stderr, flush=True)
+        yield item
+    print(f"\r{label}: {n}", file=sys.stderr)
