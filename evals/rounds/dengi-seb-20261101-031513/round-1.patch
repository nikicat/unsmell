+def parse_args(argv: list[str]) -> date | None:
+    """Returns the date_from argument, or None when it is not given. Errors when it is not
+    a YYYY-MM-DD date."""
+    parser = argparse.ArgumentParser(prog="seb", description=__doc__.splitlines()[0])
+    parser.add_argument("date_from", nargs="?", type=date.fromisoformat, help="the first day to fetch, as YYYY-MM-DD")
