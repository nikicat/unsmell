-        print(f"{iban}: {len(txs)} booked fetched since {date_from}, {count() - before} new")
+                [(account.key, t["entry_reference"], json.dumps(t, ensure_ascii=False)) for t in txs])
+        (after,) = self.db.execute(count, (account.key,)).fetchone()
