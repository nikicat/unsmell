+    def last_booking_date(self, account: Account) -> date | None:
+        """Returns the latest stored booking date of the account, or None when it has no rows."""
+        (last,) = self.db.execute("SELECT max(booking_date) FROM txn WHERE iban = ?", (account.key,)).fetchone()
+        return date.fromisoformat(last) if last else None
