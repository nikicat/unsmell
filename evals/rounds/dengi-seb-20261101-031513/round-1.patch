+@dataclass(frozen=True)
+class Login:
+    """A bank login that the user finishes in a browser. The bank then redirects to
+    Config.redirect, and the URL it redirects to carries the code for a new session."""
+
+    state: str
+    # The page where the user logs in to the bank.
+    url: str
+
+    def code(self, redirect_url: str) -> str:
+        """Returns the authorization code in the URL that the login redirected to.
+        Errors with BankError when the URL belongs to another login, or when it has no code."""
+        q = parse_qs(urlparse(redirect_url).query)
+        if q.get("state") != [self.state] or "code" not in q:
+            raise BankError(f"bad redirect: {q}")
+        return q["code"][0]
+
