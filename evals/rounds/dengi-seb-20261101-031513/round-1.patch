+def session(bank: EnableBanking) -> Session:
+    """Returns a session that has not expired. It is the saved one if there is one,
+    and otherwise a new one from a bank login.
+    Errors with BankError when a login is needed and stdin is not a terminal.
+    Errors as Session.load, Login.code and EnableBanking.create_session do."""
+    if s := Session.load():
+        return s
+    if not sys.stdin.isatty():
+        raise BankError("no valid session. Run seb from a terminal to log in to the bank.")
+    login = bank.start_login()
+    print(f"Open, log in with Smart-ID, then paste the URL you land on:\n{login.url}")
+    s = bank.create_session(login.code(input("> ").strip()))
+    s.save()
+    return s
