+class EnableBanking:
+    """The program's only way to reach Enable Banking. It signs every request as the app in config."""
+
+    HOST = "api.enablebanking.com"
+    TOKEN_LIFETIME = timedelta(hours=1)
+    # The PSD2 maximum. The bank may grant a shorter consent.
+    CONSENT_LIFETIME = timedelta(days=180)
+
+    def __init__(self, config: Config, user_ip: IpAddress | None):
+        self.config = config
+        # A request that carries the user's IP counts as made with the user present.
+        # That lifts the bank's limit of about 4 unattended reads a day.
+        self.psu_headers = {"Psu-Ip-Address": str(user_ip), "Psu-User-Agent": "dengi"} if user_ip else {}
+
+    def _headers(self) -> dict[str, str]:
+        now = datetime.now(UTC)
+        token = jwt.encode(
+            {"iss": "enablebanking.com", "aud": self.HOST, "iat": now, "exp": now + self.TOKEN_LIFETIME},
+            self.config.private_key, algorithm="RS256", headers={"kid": str(self.config.app_id)},
+        )
+        return {"Authorization": f"Bearer {token}"} | self.psu_headers
+
+    def call(self, method: str, path: str, **kw) -> Any:
+        """Returns the decoded JSON body of an API call. Errors with BankError when the response
+        status is 400 or higher."""
+        r = requests.request(method, f"https://{self.HOST}{path}", headers=self._headers(), timeout=60, **kw)
+        if not r.ok:
+            raise BankError(f"{method} {path}: {r.status_code} {r.text}")
+        return r.json()
+
+    def start_login(self) -> Login:
+        """Starts a bank login for the user to finish in a browser."""
+        state = str(uuid.uuid4())
+        url = self.call("POST", "/auth", json={
+            "access": {"valid_until": (datetime.now(UTC) + self.CONSENT_LIFETIME).isoformat()},
+            "aspsp": {"name": self.config.aspsp, "country": self.config.aspsp_country},
+            "state": state,
+            "redirect_url": self.config.redirect,
+            "psu_type": "personal",
+        })["url"]
+        return Login(state, url)
+
+    def create_session(self, code: str) -> Session:
+        """Creates a session from the authorization code of a finished login. Errors with BankError
+        when Enable Banking rejects the code, for example because it is stale or already used."""
+        return Session.parse(self.call("POST", "/sessions", json={"code": code}))
+
+    def transactions(self, account: Account, date_from: date | None) -> Iterator[Transaction]:
+        """Yields every transaction of the account, whatever its status, from date_from on.
+        When date_from is None, the bank decides how far back the transactions go."""
+        params = {"date_from": date_from.isoformat()} if date_from else {}
+        while True:
+            page = self.call("GET", f"/accounts/{account.uid}/transactions", params=params)
+            yield from page["transactions"]
+            if not (key := page.get("continuation_key")):
+                return
+            params["continuation_key"] = key
+
