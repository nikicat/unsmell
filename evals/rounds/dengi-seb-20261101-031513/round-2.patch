diff --git a/test_seb.py b/test_seb.py
new file mode 100644
index 0000000..512f741
--- /dev/null
+++ b/test_seb.py
@@ -0,0 +1,89 @@
+import unittest
+from datetime import date
+from pathlib import Path
+
+from seb import Account, BankError, EnableBanking, Login, Session, Store, Transaction, booked
+
+
+def tx(status: str, ref: str | None = "r1", day: str = "2026-10-01") -> Transaction:
+    raw = {"status": status, "booking_date": day, "credit_debit_indicator": "DBIT",
+           "transaction_amount": {"amount": "1.50", "currency": "EUR"}}
+    if ref:
+        raw["entry_reference"] = ref
+    return Transaction.parse(raw)
+
+
+class TransactionTest(unittest.TestCase):
+    def test_booked_keeps_only_status_book(self):
+        got = booked([tx("BOOK", "a"), tx("PDNG", None), tx("BOOK", "b")])
+        self.assertEqual([b.entry_reference for b in got], ["a", "b"])
+
+    def test_booked_without_entry_reference_is_a_bank_error(self):
+        with self.assertRaises(BankError):
+            tx("BOOK", None).booked()
+
+    def test_body_without_status_is_a_bank_error(self):
+        with self.assertRaises(BankError):
+            Transaction.parse({})
+
+
+NO_IBAN = Account("uid", None)
+
+
+class PagedBank(EnableBanking):
+    def __init__(self, pages):
+        self.pages = pages
+        self.params = []
+
+    def call(self, method, path, **kw):
+        self.params.append(dict(kw["params"]))
+        return self.pages.pop(0)
+
+
+class TransactionsTest(unittest.TestCase):
+    def test_follows_continuation_keys(self):
+        bank = PagedBank([{"transactions": [{"status": "BOOK"}], "continuation_key": "k"},
+                          {"transactions": [{"status": "PDNG"}]}])
+        got = [t.status for t in bank.transactions(NO_IBAN, date(2026, 10, 1))]
+        self.assertEqual(got, ["BOOK", "PDNG"])
+        self.assertEqual(bank.params, [{"date_from": "2026-10-01"},
+                                       {"date_from": "2026-10-01", "continuation_key": "k"}])
+
+    def test_page_without_transactions_is_a_bank_error(self):
+        with self.assertRaises(BankError):
+            list(PagedBank([{}]).transactions(NO_IBAN, None))
+        with self.assertRaises(BankError):
+            list(PagedBank([{"transactions": None}]).transactions(NO_IBAN, None))
+
+
+class SessionTest(unittest.TestCase):
+    def test_null_account_id_means_no_iban(self):
+        body = {"access": {"valid_until": "2027-01-01T00:00:00+00:00"},
+                "accounts": [{"uid": "u", "account_id": None}]}
+        self.assertEqual(Session.parse(body).accounts, [Account("u", None)])
+
+
+class LoginTest(unittest.TestCase):
+    def test_code_checks_state(self):
+        login = Login("s1", "https://bank/")
+        self.assertEqual(login.code("https://localhost/?state=s1&code=c"), "c")
+        with self.assertRaises(BankError):
+            login.code("https://localhost/?state=s2&code=c")
+
+
+class StoreTest(unittest.TestCase):
+    def test_upsert_counts_only_new_and_resumes_from_last_day(self):
+        store = Store(Path(":memory:"))
+        account = Account("uid", "LT01")
+        self.assertIsNone(store.last_booking_date(account))
+        first = booked([tx("BOOK", "a", "2026-10-01"), tx("BOOK", "b", "2026-10-03")])
+        self.assertEqual(store.upsert_counting_new(account, first), 2)
+        again = booked([tx("BOOK", "b", "2026-10-03"), tx("BOOK", "c", "2026-10-02")])
+        self.assertEqual(store.upsert_counting_new(account, again), 1)
+        self.assertEqual(store.last_booking_date(account), date(2026, 10, 3))
+        (amount,) = store.db.execute("SELECT amount_cents FROM txn WHERE entry_reference = 'a'").fetchone()
+        self.assertEqual(amount, -150)
+
+
+if __name__ == "__main__":
+    unittest.main()
