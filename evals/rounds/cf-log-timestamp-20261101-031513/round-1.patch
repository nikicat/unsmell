+
+/// Where the block time of a log comes from. Both the per-log lookup and the
+/// fetcher's header prefetch decide by it, so they agree on which headers
+/// are read.
+enum TimestampSource {
+    /// The timestamp the provider put on the log, in unix seconds.
+    Log(Timestamp),
+    /// The header of the block with this number.
+    Header(u64),
+}
+
+impl TimestampSource {
+    fn of(log: &Log) -> Self {
+        match log.block_timestamp {
+            Some(timestamp) => Self::Log(timestamp),
+            None => Self::Header(log_block_number(log)),
