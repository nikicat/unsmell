+async fn log_timestamp<P>(
+    provider: &P,
+    store: &LogCache,
+    log: &Log,
+) -> Result<Timestamp, HistoryError>
+where
+    P: Provider<Ethereum>,
+{
+    match TimestampSource::of(log) {
+        TimestampSource::Log(timestamp) => Ok(timestamp),
+        TimestampSource::Header(block_number) => {
