+/// Returns the timestamp of the given log's block. Uses the timestamp the log
+/// carries when the provider sent one, and otherwise the block's header from
+/// [`ensure_block_header_via`]. Errors as that function does.
+async fn log_timestamp<P>(
+    provider: &P,
+    store: &LogCache,
+    log: &Log,
+) -> Result<Timestamp, HistoryError>
+where
+    P: Provider<Ethereum>,
+{
+    if let Some(timestamp) = log.block_timestamp {
+        return Ok(timestamp);
+    }
+    let block_number = log.block_number.unwrap_or(0);
+    Ok(ensure_block_header_via(provider, store, block_number)
+        .await?
+        .timestamp)
+}
