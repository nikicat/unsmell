+			b.WriteString("\n")
+		} else {
+			b.WriteString(" ← ")
+		}
+		b.WriteString(html.EscapeString(p.Name))
+		if showPIDs {
+			fmt.Fprintf(b, "[%d]", p.PID)
 		}
 	}
