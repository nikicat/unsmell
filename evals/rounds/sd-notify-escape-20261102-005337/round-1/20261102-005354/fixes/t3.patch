diff --git a/internal/notification/markup.go b/internal/notification/markup.go
new file mode 100644
index 0000000..16971a6
--- /dev/null
+++ b/internal/notification/markup.go
@@ -0,0 +1,43 @@
+package notification
+
+import (
+	"html"
+	"strings"
+)
+
+// A notification body in the markup that notification servers render. Text
+// passed to text, bold and italic is escaped, so client-controlled values
+// cannot inject markup; only raw appends unescaped.
+type markup struct {
+	b strings.Builder
+}
+
+// Appends s, escaped.
+func (m *markup) text(s string) {
+	m.b.WriteString(html.EscapeString(s))
+}
+
+// Appends s, escaped, in bold.
+func (m *markup) bold(s string) {
+	m.b.WriteString("<b>" + html.EscapeString(s) + "</b>")
+}
+
+// Appends s, escaped, in italics.
+func (m *markup) italic(s string) {
+	m.b.WriteString("<i>" + html.EscapeString(s) + "</i>")
+}
+
+// Appends s unescaped. It is for literal separators, never for
+// client-controlled text.
+func (m *markup) raw(s string) {
+	m.b.WriteString(s)
+}
+
+// Reports whether nothing has been appended.
+func (m *markup) empty() bool {
+	return m.b.Len() == 0
+}
+
+func (m *markup) String() string {
+	return m.b.String()
+}
diff --git a/internal/notification/markup_test.go b/internal/notification/markup_test.go
new file mode 100644
index 0000000..5cc2b9a
--- /dev/null
+++ b/internal/notification/markup_test.go
@@ -0,0 +1,17 @@
+package notification
+
+import "testing"
+
+func TestMarkup_EscapesText(t *testing.T) {
+	var m markup
+	m.bold(`<a href="x">&`)
+	m.raw(" | ")
+	m.italic("<b>")
+	m.raw(" | ")
+	m.text("</i>'")
+
+	want := `<b>&lt;a href=&#34;x&#34;&gt;&amp;</b> | <i>&lt;b&gt;</i> | &lt;/i&gt;&#39;`
+	if got := m.String(); got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
