 	b strings.Builder
 }
 
+// The escaper for markup text. It replaces only &, < and >, because servers
+// such as GNOME Shell accept only named entities. They would show the numeric
+// &#39; and &#34; that html.EscapeString writes as literal text.
+var markupEscaper = strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;")
+
 func (m *markup) text(s string) {
