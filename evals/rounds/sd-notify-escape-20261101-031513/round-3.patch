diff --git a/internal/notification/body.go b/internal/notification/body.go
new file mode 100644
index 0000000..ab07019
--- /dev/null
+++ b/internal/notification/body.go
@@ -0,0 +1,126 @@
+package notification
+
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+
+	"github.com/nikicat/secrets-dispatcher/internal/approval"
+)
+
+func (h *Handler) formatBody(req *approval.Request) markup {
+	b := bodyBuilder{showPIDs: h.showPIDs}
+
+	switch req.Type {
+	case approval.RequestTypeGPGSign:
+		if req.GPGSignInfo == nil {
+			return b.markup
+		}
+		b.gpgSubject(req.GPGSignInfo)
+	case approval.RequestTypeSSHSign:
+		if len(req.Items) > 0 {
+			b.sshSubject(req.Items[0])
+		}
+	default:
+		subject, hasSubject := itemsSubject(req)
+		if len(req.SenderInfo.ProcessChain) == 0 {
+			// Remote requests carry no process chain, so the sender comes first.
+			b.sender(req)
+			if hasSubject {
+				b.italic(subject)
+			}
+		} else if hasSubject {
+			b.bold(subject)
+		}
+	}
+	b.processChain(req.SenderInfo.ProcessChain)
+
+	return b.markup
+}
+
+// The body of one approval notification while it is being built. It carries
+// the handler's PID setting, so the rendering methods need no Handler.
+type bodyBuilder struct {
+	markup
+	showPIDs bool
+}
+
+// Appends the repository in bold and the commit subject in italics.
+func (b *bodyBuilder) gpgSubject(info *approval.GPGSignInfo) {
+	b.bold(info.RepoName)
+	b.text(": ")
+	b.italic(commitSubject(info.CommitMsg))
+}
+
+// Appends the key label in bold. If the key's attributes name a destination
+// host, an arrow and the host follow the label.
+func (b *bodyBuilder) sshSubject(key approval.ItemInfo) {
+	b.bold(key.Label)
+	if dest := key.Attributes["destination"]; dest != "" {
+		b.text(" → " + dest)
+	}
+}
+
+// Appends the process chain on a new line, starting with the requesting
+// process. Each process name is followed by its PID when the builder shows PIDs.
+// An empty chain appends nothing.
+func (b *bodyBuilder) processChain(chain []approval.ProcessInfo) {
+	for i, p := range chain {
+		if i == 0 {
+			b.text("\n")
+		} else {
+			b.text(" ← ")
+		}
+		b.text(p.Name)
+		if b.showPIDs {
+			b.textf("[%d]", p.PID)
+		}
+	}
+}
+
+// Appends who sent the request, followed by a colon. If the request names an
+// invoker, the sender is the invoker in bold, followed by "@", the client and
+// the PID. Otherwise the sender is the client in bold, followed by the PID
+// when it is nonzero.
+func (b *bodyBuilder) sender(req *approval.Request) {
+	switch {
+	case req.SenderInfo.InvokerName != "":
+		b.bold(req.SenderInfo.InvokerName)
+		b.textf("@%s[%d]", req.Client, req.SenderInfo.PID)
+	case req.SenderInfo.PID != 0:
+		b.bold(req.Client)
+		b.textf("[%d]", req.SenderInfo.PID)
+	default:
+		b.bold(req.Client)
+	}
+	b.text(": ")
+}
+
+// Returns the label, item count or search attributes that a secret request is
+// about. A search with no attributes is about "all". The second result is false
+// for request types that have no such subject.
+func itemsSubject(req *approval.Request) (string, bool) {
+	switch req.Type {
+	case approval.RequestTypeGetSecret, approval.RequestTypeDelete, approval.RequestTypeWrite:
+		if len(req.Items) == 1 {
+			return req.Items[0].Label, true
+		}
+		return fmt.Sprintf("%d items", len(req.Items)), true
+	case approval.RequestTypeSearch:
+		if len(req.SearchAttributes) == 0 {
+			return "all", true
+		}
+		return searchAttrsText(req.SearchAttributes), true
+	}
+	return "", false
+}
+
+// Returns the search attributes as "k=v, k=v", sorted by key.
+func searchAttrsText(attrs map[string]string) string {
+	pairs := make([]string, 0, len(attrs))
+	for _, k := range slices.Sorted(maps.Keys(attrs)) {
+		pairs = append(pairs, k+"="+attrs[k])
+	}
+	return strings.Join(pairs, ", ")
+}
