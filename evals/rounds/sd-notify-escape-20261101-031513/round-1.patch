diff --git a/internal/notification/markup.go b/internal/notification/markup.go
new file mode 100644
index 0000000..fd1454b
--- /dev/null
+++ b/internal/notification/markup.go
@@ -0,0 +1,44 @@
+package notification
+
+import (
+	"fmt"
+	"html"
+	"strings"
+)
+
+// A notification body in the markup subset of the Desktop Notifications spec.
+// Text written through it is escaped, so the only markup in the body is the
+// tags that it writes itself.
+type markup struct {
+	b strings.Builder
+}
+
+func (m *markup) text(s string) {
+	m.b.WriteString(html.EscapeString(s))
+}
+
+func (m *markup) textf(format string, args ...any) {
+	m.text(fmt.Sprintf(format, args...))
+}
+
+func (m *markup) bold(s string) {
+	m.tagged("b", s)
+}
+
+func (m *markup) italic(s string) {
+	m.tagged("i", s)
+}
+
+func (m *markup) tagged(tag, s string) {
+	fmt.Fprintf(&m.b, "<%s>", tag)
+	m.text(s)
+	fmt.Fprintf(&m.b, "</%s>", tag)
+}
+
+func (m *markup) empty() bool {
+	return m.b.Len() == 0
+}
+
+func (m *markup) String() string {
+	return m.b.String()
+}
