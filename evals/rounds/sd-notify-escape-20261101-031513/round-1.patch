+// Appends the repository in bold and the commit subject in italics.
+func writeGPGSubject(m *markup, info *approval.GPGSignInfo) {
+	m.bold(info.RepoName)
+	m.text(": ")
+	m.italic(commitSubject(info.CommitMsg))
+}
+
+// Appends the key label in bold and the destination host, when the request
+// names one.
+func writeSSHSubject(m *markup, key approval.ItemInfo) {
+	m.bold(key.Label)
+	if dest := key.Attributes["destination"]; dest != "" {
+		m.text(" → " + dest)
+	}
+}
+
+// Appends the process chain on a new line, starting with the requesting
+// process. Each process name is followed by its PID when the handler shows PIDs.
+func (h *Handler) writeProcessChain(m *markup, chain []approval.ProcessInfo) {
+	for i, p := range chain {
+		if i == 0 {
+			m.text("\n")
+		} else {
+			m.text(" ← ")
+		}
+		m.text(p.Name)
+		if h.showPIDs {
+			m.textf("[%d]", p.PID)
+		}
+	}
+}
+
+// Appends who sent the request. With an invoker name, the invoker is bold
+// and the client and PID follow it. Otherwise the client is bold, followed by
+// the PID when it is nonzero.
+func writeSender(m *markup, req *approval.Request) {
+	switch {
+	case req.SenderInfo.InvokerName != "":
+		m.bold(req.SenderInfo.InvokerName)
+		m.textf("@%s[%d]: ", req.Client, req.SenderInfo.PID)
+	case req.SenderInfo.PID != 0:
+		m.bold(req.Client)
+		m.textf("[%d]: ", req.SenderInfo.PID)
+	default:
+		m.bold(req.Client)
+		m.text(": ")
+	}
+}
+
+// Returns what a get, write, delete or search request is about. For a single
+// item, that is its label, and for any other number of items, the count. For a
+// search, it is the search attributes, or "all" when there are none. The
+// second result is false for any other request type.
+func itemsSubject(req *approval.Request) (string, bool) {
+	switch req.Type {
+	case approval.RequestTypeGetSecret, approval.RequestTypeDelete, approval.RequestTypeWrite:
+		if len(req.Items) == 1 {
+			return req.Items[0].Label, true
 		}
+		return fmt.Sprintf("%d items", len(req.Items)), true
+	case approval.RequestTypeSearch:
+		if len(req.SearchAttributes) == 0 {
+			return "all", true
+		}
+		return searchAttrsText(req.SearchAttributes), true
 	}
+	return "", false
+}
 
