@@ -0,0 +1,16 @@
+package notification
+
+import "testing"
+
+func TestMarkup_EscapesTextInsideOwnTags(t *testing.T) {
+	var m markup
+	m.bold("<i>a&b")
+	m.text(" ")
+	m.italic(`"q"`)
+	m.textf(" [%s]", "</b>")
+
+	want := "<b>&lt;i&gt;a&amp;b</b> <i>&#34;q&#34;</i> [&lt;/b&gt;]"
+	if got := m.String(); got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
