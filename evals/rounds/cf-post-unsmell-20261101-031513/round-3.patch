+/// `Topic` persists as its 32 raw bytes in a `BLOB` column. It has no
+/// `FromSql`, because each reader decides what a stored topic of the wrong
+/// length means.
+impl ToSql for Topic {
+    fn to_sql(&self) -> rusqlite::Result<ToSqlOutput<'_>> {
+        Ok(ToSqlOutput::from(self.as_slice()))
+    }
+}
