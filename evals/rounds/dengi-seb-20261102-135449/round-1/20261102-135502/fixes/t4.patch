+class RawBody(BaseModel):
+    """An Enable Banking body that keeps the JSON it was parsed from, so that it can be stored unchanged."""
+
+    _raw: dict = PrivateAttr()
+
+    @model_validator(mode="wrap")
+    @classmethod
+    def _keep_raw(cls, data, handler):
+        body = handler(data)
+        body._raw = data
+        return body
+
+    @property
+    def raw(self) -> dict:
+        return self._raw
+
+
+class AuthStart(BaseModel):
+    """The bank's reply to a new authorization request, giving the login page for the user."""
+
+    url: str
+
+
+class Account(BaseModel):
+    """An account that a session grants access to."""
+
+    uid: str
+    iban: str | None = Field(default=None, validation_alias=AliasPath("account_id", "iban"))
+
+    @property
+    def key(self) -> str:
+        """The account's IBAN, or its uid when the bank gives no IBAN."""
+        return self.iban or self.uid
+
+
+class Session(RawBody):
+    """A session as /sessions returns it and session.json saves it."""
+
+    valid_until: AwareDatetime = Field(validation_alias=AliasPath("access", "valid_until"))
+    accounts: list[Account]
+
+    @property
+    def expired(self) -> bool:
+        return self.valid_until <= datetime.now(timezone.utc)
+
+
+class Transaction(RawBody):
+    status: str
+    entry_reference: str | None = None  # pending transactions have none
+
+
+class TransactionPage(BaseModel):
+    transactions: list[Transaction]
+    continuation_key: str | None = None
 
 
