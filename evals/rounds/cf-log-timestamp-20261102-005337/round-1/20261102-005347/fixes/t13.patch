+/// Merge inclusive `(start, end, payload)` ranges, sorted by `start`, whose
+/// spans overlap or touch. Each merged range keeps the payload of its first
+/// member with the highest `end`.
+fn coalesce_ranges<P>(sorted: impl IntoIterator<Item = (u64, u64, P)>) -> Vec<(u64, u64, P)> {
+    let mut merged: Vec<(u64, u64, P)> = Vec::new();
+    for (start, end, payload) in sorted {
+        match merged.last_mut() {
+            Some(last) if last.1.saturating_add(1) >= start => {
+                if end > last.1 {
+                    last.1 = end;
+                    last.2 = payload;
+                }
+            }
+            _ => merged.push((start, end, payload)),
+        }
+    }
+    merged
+}
