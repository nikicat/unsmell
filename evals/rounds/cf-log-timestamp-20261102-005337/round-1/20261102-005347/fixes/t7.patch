+/// Builds the event from a mined provider log. Fails on a log that lacks its
+/// block number, block hash, transaction hash or log index (a pending log), or
+/// whose log index does not fit in `u32`. A missing `block_timestamp` becomes
+/// 0, for the caller to fill from the block header.
+impl TryFrom<&Log> for EvmEvent {
+    type Error = HistoryError;
+
+    fn try_from(log: &Log) -> Result<Self, Self::Error> {
+        let missing = |field: &str| HistoryError::internal(format!("log has no {field}"));
+        let log_index = log.log_index.ok_or_else(|| missing("log_index"))?;
+        Ok(Self {
+            contract_address: log.address().0.0,
+            block_number: log.block_number.ok_or_else(|| missing("block_number"))?,
+            timestamp: log.block_timestamp.unwrap_or(0),
+            block_hash: log.block_hash.ok_or_else(|| missing("block_hash"))?.0,
+            log_index: u32::try_from(log_index).map_err(|_| {
+                HistoryError::internal(format!("log_index {log_index} exceeds u32"))
+            })?,
+            tx_hash: log
+                .transaction_hash
+                .ok_or_else(|| missing("transaction_hash"))?
+                .0,
+            topics: log.topics().iter().map(|t| t.0).collect(),
+            data: log.data().data.to_vec(),
+        })
+    }
+}
