+/// Returns the Unix timestamp of the block that holds `log`. A log that
+/// carries its own timestamp needs no block header. For any other log, the
+/// timestamp comes from the block header. Errors when the header fetch fails.
+async fn log_timestamp<P: Provider<Ethereum>>(
+    provider: &P,
+    store: &LogCache,
+    log: &Log,
+) -> Result<u64, HistoryError> {
+    if let Some(timestamp) = log.block_timestamp {
+        return Ok(timestamp);
+    }
+    let block_number = log.block_number.unwrap_or(0);
+    Ok(ensure_block_header_via(provider, store, block_number)
+        .await?
+        .timestamp)
+}
