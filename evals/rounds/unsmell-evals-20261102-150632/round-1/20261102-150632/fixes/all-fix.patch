+def record_change(record, task, fixture, sighting):
+    """Adds the change that task made in one skill run directory to the dataset, and returns its id.
+
+    sighting is an entry of the change's seen list. It names the run, round and task the change came from.
+    A change that the dataset already holds gains the sighting when it is new.
+    """
+    patch_file = record / "fixes" / f"{task.name}.patch"
+    patch = patch_file.read_text() if patch_file.exists() else ""
+    cid = change_id(patch) if patch.strip() else f"{sighting['run']}-{sighting['round']}-{task.name}"
+    d = CHANGES / cid
+    d.mkdir(parents=True, exist_ok=True)
+    meta = load(d / "change.yaml") if (d / "change.yaml").exists() else {
+        "id": cid, "fixture": fixture, "seen": [], "judge": None, "labels": []}
+    if sighting not in meta["seen"]:
+        meta["seen"].append(sighting)
+        # The findings and decisions of the first sighting, which the patch was made for.
+        meta.setdefault("findings", task.findings)
+    if not (d / "change.patch").exists():
+        (d / "change.patch").write_text(patch)
+    dump(d / "change.yaml", meta)
+    return cid
