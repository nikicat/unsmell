+def by_user(label):
+    """Tells whether a person gave a label entry of change.yaml."""
+    return label["by"].startswith(USER)
+
+
+def newest_label(change):
+    """Returns the change's newest label entry, or None when it has none."""
+    return change["labels"][-1] if change["labels"] else None
+
+
+def newest_user_label(change):
+    """Returns the newest label entry that a person gave the change, or None when no person labelled it."""
+    return next((l for l in reversed(change["labels"]) if by_user(l)), None)
+
+
+def has_patch(change):
+    """Tells whether the change's editor made a patch."""
+    return bool((CHANGES / change["id"] / "change.patch").read_text().strip())
+
+
+def decisions(change):
