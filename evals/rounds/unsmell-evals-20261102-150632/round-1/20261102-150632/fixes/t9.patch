+class Label(StrEnum):
+    """A verdict on whether a change was worth making, given by a person or proposed by the judge."""
+
+    GOOD = "good"
+    BAD = "bad"
+    NEUTRAL = "neutral"
+    UNSURE = "unsure"
+
+    @property
+    def meaning(self):
+        """What the label says about a change, in the words of the judge's prompt."""
+        return {Label.GOOD: "worth making", Label.BAD: "should not have been made, or made worse code",
+                Label.NEUTRAL: "neither better nor worse", Label.UNSURE: "looked at, but cannot judge it"}[self]
+
+    @property
+    def color(self):
+        """The ANSI SGR code that show paints the label in."""
+        return {Label.GOOD: "32", Label.BAD: "31", Label.NEUTRAL: "33", Label.UNSURE: "90"}[self]
+
+    @classmethod
+    def verdicts(cls):
+        """Returns the labels the judge may give.
+
+        The judge may not give unsure, which means that a person looked at the change and cannot judge it.
+        """
+        return [l for l in cls if l is not cls.UNSURE]
+
+
+class Decision(StrEnum):
+    """A triage bucket that the skill puts a finding in (SKILL.md §5)."""
+
+    FIX = "FIX"
+    ASK = "ASK"
+    PLAN = "PLAN"
+    KEEP = "KEEP"
+    SKIP = "SKIP"
+    DISCARD = "DISCARD"
+
+    @property
+    def color(self):
+        """The ANSI SGR code that show paints the decision in."""
+        return {Decision.FIX: "32", Decision.ASK: "33", Decision.PLAN: "36", Decision.KEEP: "35",
+                Decision.SKIP: "90", Decision.DISCARD: "90"}[self]
+
+
+class CheckStatus(StrEnum):
