+@dataclass(frozen=True)
+class EnableBanking:
+    config: Config
+    psu: dict[str, str]
+
+    def headers(self) -> dict[str, str]:
+        now = int(datetime.now(timezone.utc).timestamp())
+        token = jwt.encode(
+            {"iss": "enablebanking.com", "aud": "api.enablebanking.com", "iat": now, "exp": now + 3600},
+            self.config.key, algorithm="RS256", headers={"kid": self.config.app_id},
+        )
+        return {"Authorization": f"Bearer {token}"} | self.psu
+
+    def call(self, method: str, path: str, **kw) -> dict:
+        r = requests.request(method, API + path, headers=self.headers(), timeout=60, **kw)
+        if not r.ok:
+            sys.exit(f"{method} {path}: {r.status_code} {r.text}")
+        return r.json()
+
+    def authorize(self) -> Session:
+        """Logs the user in at the bank and stores the new session.
+        Exits when the pasted URL does not belong to this login."""
+        state = str(uuid.uuid4())
+        # 180 days is the PSD2 maximum. The bank may grant less.
+        valid_until = datetime.now(timezone.utc) + timedelta(days=180)
+        url = self.call("POST", "/auth", json={
+            "access": {"valid_until": valid_until.isoformat()},
+            "aspsp": {"name": self.config.aspsp, "country": "LT"},
+            "state": state,
+            "redirect_url": self.config.redirect,
+            "psu_type": "personal",
+        })["url"]
+        print(f"Open, log in with Smart-ID, then paste the URL you land on:\n{url}")
+        q = parse_qs(urlparse(input("> ").strip()).query)
+        if q.get("state") != [state]:
+            sys.exit(f"bad redirect: {q}")
+        session = Session.from_json(self.call("POST", "/sessions", json={"code": q["code"][0]}))
+        session.save(SESSION)
+        return session
+
+    def session(self) -> Session:
+        """Returns a session that has not expired.
+        Authorizes a new one when none is stored or the stored one has expired."""
+        session = Session.load(SESSION)
+        if session and not session.expired:
+            return session
+        return self.authorize()
+
+    def transactions(self, uid: str, since: date | None) -> list[dict]:
+        params, out = {"date_from": since.isoformat()} if since else {}, []
+        while True:
+            page = self.call("GET", f"/accounts/{uid}/transactions", params=params)
+            out += page["transactions"]
+            print(f"\r{uid}: {len(out)} transactions", end="", file=sys.stderr, flush=True)
+            if not page.get("continuation_key"):
+                print(file=sys.stderr)
+                return out
+            params["continuation_key"] = page["continuation_key"]
+
