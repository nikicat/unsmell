+@dataclass(frozen=True)
+class Store:
+    db: sqlite3.Connection
+
+    @classmethod
+    def open(cls, path: Path | str) -> Store:
+        db = sqlite3.connect(path)
+        db.executescript(Path(__file__).with_name("schema.sql").read_text())
+        return cls(db)
+
+    def last_booking_date(self, key: str) -> date | None:
+        day = self.db.execute("SELECT max(booking_date) FROM txn WHERE iban = ?", (key,)).fetchone()[0]
+        return date.fromisoformat(day) if day else None
+
+    def _count(self, key: str) -> int:
+        return self.db.execute("SELECT count(*) FROM txn WHERE iban = ?", (key,)).fetchone()[0]
+
+    def upsert(self, key: str, txs: list[dict]) -> int:
+        """Stores txs under the account key and returns how many were new.
+        A stored transaction is updated when its JSON has changed."""
+        before = self._count(key)
+        with self.db:
+            self.db.executemany(
+                "INSERT INTO txn (iban, entry_reference, raw) VALUES (?, ?, ?)"
+                " ON CONFLICT DO UPDATE SET raw = excluded.raw WHERE raw IS NOT excluded.raw",
+                [(key, t["entry_reference"], json.dumps(t, ensure_ascii=False)) for t in txs])
+        return self._count(key) - before
+
+
+def parse_date_from(args: list[str]) -> date | None:
+    """Returns the date_from argument, or None when it is not given.
+    Exits when it is not a YYYY-MM-DD date."""
+    if not args:
+        return None
+    try:
+        return date.fromisoformat(args[0])
+    except ValueError:
+        sys.exit(f"usage: seb [date_from YYYY-MM-DD], not {args[0]!r}")
 
 
